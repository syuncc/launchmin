# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/launchmin

# HTTP
CORS_ORIGIN=http://localhost:5173
API_BASE=/api

# JWT signing (HS256). Generate each secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# REQUIRED — server refuses to start without these. Use distinct values per environment.
JWT_SECRET=
JWT_ISSUER=launchmin
JWT_AUDIENCE=launchmin-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# CSRF signing. Same generation method as JWT_SECRET. REQUIRED.
CSRF_SECRET=

# Brute-force prevention on /auth/login.
# Per-IP in-memory rate limit; per-account lockout (DB-backed) is hard-coded
# to 5 attempts / 15 min lockout in auth.service.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
